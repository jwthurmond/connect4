<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- Build as a class library so the DLL can be dropped into the plugins folder -->
    <OutputType>Library</OutputType>
    <!--
      Do NOT copy connect4.tournament.dll / connect4.library.dll into the output —
      the host process already has them loaded. Keeping them out avoids type-identity mismatches.
    -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference the tournament project so you can implement IConnect4Player.
      Set ExcludeAssets="runtime" so the DLLs are NOT copied to output.
    -->
    <ProjectReference Include="..\connect4.tournament\connect4.tournament.csproj">
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
